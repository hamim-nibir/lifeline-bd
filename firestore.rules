rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper functions ──
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isOperator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == "operator";
    }
    
    function isAllowedContactUpdate() {
      return request.resource.data.keys().hasOnly([
        "userId", "name", "phone", "relationship",
        "notifyOnSOS", "createdAt"
      ]);
    }
    
    function isAllowedSOSEventCreate() {
      return request.resource.data.keys().hasOnly([
        "userId", "userName", "latitude", "longitude",
        "address", "status", "source", "triggeredAt", "resolvedAt",
        "sosPhase", "operatorAccepted", "responderStatus",
        "etaMinutesMin", "etaMinutesMax", "sosAlertId", "lastLocationAt"
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.status == "active";
    }
    
    function isAllowedSOSEventUpdate() {
      return request.resource.data.keys().hasOnly([
        "userId", "userName", "latitude", "longitude", "address",
        "status", "source", "triggeredAt", "resolvedAt", "lastLocationAt"
      ])
      && resource.data.userId == request.auth.uid;
    }

    // ── Users ──
    // Any signed-in user can read (operators need to read for verification)
    // Only owner can create their own profile
    // Any signed-in user can update (operators approve verification on user docs)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isSignedIn();
    }

    // ── Important contacts (subcollection) ──
    match /users/{userId}/importantContacts/{contactId} {
      allow read, write: if isOwner(userId);
    }

    // ── Panic alerts ──
    match /panicAlerts/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ── Accident reports ──
    match /accidentReports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ── Notifications ──
    // Citizens can create (when submitting reports)
    // Anyone signed in can read their own or operators read all
    // Anyone signed in can update (mark as read)
    match /notifications/{notifId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isOperator()
        || (resource.data.forUid != null && resource.data.forUid == request.auth.uid)
        || (resource.data.reportedByUid != null && resource.data.reportedByUid == request.auth.uid)
      );
      allow update: if isSignedIn();
      allow delete: if request.auth != null;
    }

    // ── Verification requests ──
    // Citizens create and read, only operators can approve/reject
    match /verificationRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // ── Blood donation history ──
    match /bloodDonationHistory/{uid}/records/{recordId} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ── Blood requests ──
    match /bloodRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
    }

    // ── Chats ──
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }
    
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // ── Emergency contacts (separate collection) ──
    match /emergency_contacts/{contactId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isAllowedContactUpdate();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isOperator()
      );
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isAllowedContactUpdate();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── SOS events ──
    match /sos_events/{eventId} {
      allow create: if isSignedIn() && isAllowedSOSEventCreate();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isOperator()
      );
      allow update: if isSignedIn() && (
        isOperator()
        || (
          resource.data.userId == request.auth.uid
          && (
            (
              request.resource.data.diff(resource.data).changedKeys().hasOnly([
                "latitude", "longitude", "address", "lastLocationAt"
              ])
            )
            || (
              resource.data.status == "active"
              && request.resource.data.status == "cancelled"
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                "status", "resolvedAt"
              ])
            )
          )
        )
      );
      allow delete: if false;
    }

    // ── SOS alerts ──
    match /sos_alerts/{alertId} {
      allow create: if isSignedIn()
        && request.resource.data.reportedByUid == request.auth.uid;
      allow read: if isSignedIn() && (
        isOperator()
        || (resource.data.reportedByUid != null && resource.data.reportedByUid == request.auth.uid)
      );
      allow update: if isOperator()
        || (
          isSignedIn()
          && resource.data.reportedByUid == request.auth.uid
          && request.resource.data.reportedByUid == request.auth.uid
          && resource.data.sosCancelled == false
          && request.resource.data.sosCancelled == true
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "sosCancelled", "cancelledAt", "title", "body"
          ])
        );
      allow delete: if false;
    }

    // ── Quick emergency services ──
    match /quickEmergencyServices/{serviceId} {
      allow read: if true;
      allow write: if isOperator();
    }

    // ── Ambulance requests ──
    match /ambulance_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        isOperator() || resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isOperator() || resource.data.userId == request.auth.uid
      );
      allow delete: if false;
    }

    // ── Fire dispatches ──
    match /fire_dispatches/{dispatchId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        isOperator() || resource.data.userId == request.auth.uid
      );
      allow update: if isOperator()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // ── Police alerts ──
    match /policeAlerts/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Police reports ──
    match /policeReports/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Security requests ──
    match /securityRequests/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Unified requests ──
    match /unifiedRequests/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Operator chats ──
    match /operatorChats/{uid}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Training Platform Rules ──
    match /training/courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isOperator();

      match /videos/{videoId} {
        allow read: if true;
        allow create, update, delete: if isOperator();
      }
    }

    match /training/enrollments/{enrollmentId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        isOperator() || resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /training/progress_history/{historyId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        isOperator() || resource.data.userId == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /training/certificates/{certificateId} {
      allow read: if isSignedIn() && (
        isOperator() || resource.data.userId == request.auth.uid
      );
      allow create: if isOperator();
      allow update, delete: if false;
    }

    match /training/achievements/{achievementId} {
      allow read: if true;
      allow create, update, delete: if isOperator();
    }

    match /training/user_achievements/{userAchievementId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        isOperator() || resource.data.userId == request.auth.uid
      );
      allow update, delete: if false;
    }

    // ── Deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
